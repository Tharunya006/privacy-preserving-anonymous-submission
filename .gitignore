# ---------------------------------------------------------------------------
# Secrets -- never commit these
# ---------------------------------------------------------------------------
.env
.env.*
!.env.example
*.pem
*.key

# ---------------------------------------------------------------------------
# Databases (SQLite) -- generated locally, never shared
# ---------------------------------------------------------------------------
instance/
*.db
*.sqlite
*.sqlite3
*.db-journal

# ---------------------------------------------------------------------------
# Python
# ---------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
build/
dist/
.eggs/

# Virtual environments
.venv/
venv/
env/
ENV/

# Testing / coverage
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.mypy_cache/

# ---------------------------------------------------------------------------
# Editors / OS
# ---------------------------------------------------------------------------
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db

# Phase 6 analysis output that may contain test credentials / raw traffic.
# The generated reports (benchmark.*, traffic_report.*) are committed.
analysis/results/*.pcap
analysis/results/*.pcapng
analysis/results/capture_meta.json
