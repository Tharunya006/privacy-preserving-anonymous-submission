# Environment template for the integrated application (app.py).
# Copy to .env and fill in real values.  .env is git-ignored and must never
# be committed -- it holds the session signing key.
#
# Generate a key with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"

PHASE2_SECRET_KEY=replace-me-with-a-random-48-byte-urlsafe-string
PHASE2_ENV=development

# Phase 5 -- report and evidence encryption (AES-256-GCM) and integrity
# (HMAC-SHA-256).  Two DIFFERENT 256-bit keys, base64url-encoded.  Generate each
# one separately with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# The app refuses to start while these are missing or invalid (the placeholders
# below are deliberately invalid).  Losing them makes every stored report and
# evidence file unreadable -- back them up somewhere safe, apart from the
# database.  Never commit them.
PHASE5_ENCRYPTION_KEY=replace-me-with-output-of-token_urlsafe-32
PHASE5_HMAC_KEY=replace-me-with-a-different-token_urlsafe-32
# Allowed clock drift for protected timestamps, in seconds.
PHASE5_MAX_CLOCK_SKEW_SECONDS=300

# The one SQLite database for accounts, audit log and submissions.
# Leave this unset to use the default,
# <project-root>/instance/phase2.db -- that works on macOS, Linux and Windows
# and from whatever directory you run `flask` in.
# Uncomment only to move the database; a relative path is resolved against the
# project root, an absolute path is used as-is.
# PHASE2_DATABASE_URI=sqlite:///instance/phase2.db

# Session / cookie behaviour
PHASE2_SESSION_MINUTES=30
PHASE2_IDLE_TIMEOUT_MINUTES=15
PHASE2_COOKIE_SECURE=false        # set to true when served over HTTPS

# Password policy
PHASE2_PASSWORD_MIN_LENGTH=10
PHASE2_HASH_METHOD=pbkdf2:sha256:600000

# Brute-force lockout
PHASE2_MAX_FAILED_LOGINS=5
PHASE2_LOCKOUT_MINUTES=15

# Anonymous submission evidence.  Files are stored privately (never under a
# static folder) and served only to authorized journalists.  Defaults to
# <project-root>/instance/evidence, which is git-ignored.
# PHASE2_EVIDENCE_DIR=instance/evidence
PHASE2_EVIDENCE_MAX_MB=10

# Dev server
PHASE2_HOST=127.0.0.1
PHASE2_PORT=5001

# Only read by the `create-admin` CLI command during bootstrap.
# Leave unset to be prompted at the terminal instead (preferred).
# PHASE2_ADMIN_PASSWORD=
